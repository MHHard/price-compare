<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="@dimen/space_2"
    android:layout_weight="1"
    android:background="@drawable/bg_price_cell"
    android:minWidth="0dp">

    <View
        android:id="@+id/platformStripe"
        android:layout_width="@dimen/platform_stripe_width"
        android:layout_height="match_parent"
        android:background="@drawable/stripe_jd" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:orientation="vertical"
        android:paddingStart="6dp"
        android:paddingTop="@dimen/space_2"
        android:paddingEnd="@dimen/space_2"
        android:paddingBottom="@dimen/space_2">

        <TextView
            android:id="@+id/platformLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.08"
            android:maxLines="1"
            android:textColor="@color/platform_jd"
            android:textSize="@dimen/price_cell_label_size"
            tools:text="JD 京东" />

        <TextView
            android:id="@+id/platformPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="sans-serif-medium"
            android:fontFeatureSettings="tnum"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/price_cell_price_size"
            android:textStyle="bold"
            tools:text="¥18" />
    </LinearLayout>
</FrameLayout>
